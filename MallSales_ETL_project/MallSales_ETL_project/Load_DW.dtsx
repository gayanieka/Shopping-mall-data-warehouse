                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    shopping_mall,
    TRY_CAST(construction_year AS INT) AS construction_year,
    TRY_CAST(
        REPLACE(REPLACE(area_sqm, ',', ''), '"', '') 
    AS DECIMAL(10)) AS area_sqm,
    location,
    TRY_CAST(store_count AS INT) AS store_count
FROM dbo.StgMall
WHERE shopping_mall IS NOT NULL;</property>
